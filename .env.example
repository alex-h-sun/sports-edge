# ── pipeline (offline) ──────────────────────────────────────────────────────────
ODDS_API_KEY=your_key_here
DB_PATH=data/sports.db
BANKROLL=1000
MIN_EDGE=0.03

# ── web app (webapp/) ───────────────────────────────────────────────────────────
# Single shared password gating the whole app (empty disables the gate — dev only).
APP_PASSWORD=change-me
# Secret for signing the session cookie. Generate one, e.g. `openssl rand -hex 32`.
SESSION_SECRET=
# Where the serving DB/artifacts/ledger live (the snapshot volume in production).
ARTIFACTS_DIR=models/artifacts
LEDGER_PATH=data/sims/paper_ledger.csv

# ── snapshot sync (offline batch -> serving volume) ─────────────────────────────
# s3://bucket/prefix or file:///abs/dir; empty disables syncing (manual volume).
SNAPSHOT_URL=
SNAPSHOT_DATA_DIR=/data
# S3 / Cloudflare R2 credentials (only when SNAPSHOT_URL is s3://...)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# S3_ENDPOINT_URL=          # set for Cloudflare R2, e.g. https://<acct>.r2.cloudflarestorage.com
